---
// The Governance Scan as a notched band at the top of the work page, above
// the roles. It links to the scan page under /work/governance-scan/.
---
<a href="/work/governance-scan/" class="offer-band glass notched focus-item">
  <span class="offer-band__label meta">Offer</span>
  <span class="offer-band__title">Governance Scan</span>
  <span class="offer-band__line meta">A six week scan for care organisations: does your governance framework work in practice?</span>
</a>

<style>
  .offer-band {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-bottom: var(--space-8);
    padding-top: var(--space-6);
    padding-bottom: var(--space-6);
    padding-left: var(--space-6);
    text-decoration: none;
    transition: var(--focus-transition);
  }
  .offer-band__label {
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .offer-band__title {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: var(--tracking-title);
    line-height: var(--leading-tight);
  }
  .offer-band__line {
    max-width: 50ch;
    font-size: var(--text-base);
  }
  @media (max-width: 600px) {
    .offer-band {
      padding-top: var(--space-4);
      padding-bottom: var(--space-4);
      padding-left: var(--space-4);
    }
    .offer-band__title {
      font-size: var(--text-xl);
    }
  }
</style>
