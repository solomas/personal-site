---
// Switches between day and night. Night is stored as localStorage "theme" =
// "flip", day as "mist". With nothing stored the page follows the system
// setting, also when it changes while the page is open. The button is an
// icon, a half filled circle in the text colour. Its label names the theme it
// switches to.
---
<button id="theme-toggle" class="theme-toggle glass-button focus-context" type="button" aria-label="Switch theme">
  <svg class="theme-toggle__icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
    <circle cx="10" cy="10" r="7.5" fill="none" stroke="currentColor" stroke-width="1.75" />
    <path d="M10 2.5 A7.5 7.5 0 0 0 10 17.5 Z" fill="currentColor" />
  </svg>
</button>

<style>
  /* A round icon button, the same height as the Menu button. */
  .theme-toggle {
    flex-shrink: 0;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
  }
  .theme-toggle__icon {
    width: 1.1rem;
    height: 1.1rem;
  }
</style>

<script>
  const btn = document.getElementById("theme-toggle");
  const root = document.documentElement;
  const darkQuery = window.matchMedia("(prefers-color-scheme: dark)");

  function isNight() {
    return root.getAttribute("data-theme") === "flip";
  }

  function apply(night: boolean) {
    if (night) {
      root.setAttribute("data-theme", "flip");
    } else {
      root.removeAttribute("data-theme");
    }
    btn?.setAttribute("aria-label", night ? "Switch to light theme" : "Switch to dark theme");
  }

  function storedChoice() {
    try { return localStorage.getItem("theme"); } catch (e) { return null; }
  }

  apply(isNight());

  btn?.addEventListener("click", () => {
    const night = !isNight();
    apply(night);
    try { localStorage.setItem("theme", night ? "flip" : "mist"); } catch (e) {}
  });

  darkQuery.addEventListener("change", (e) => {
    const saved = storedChoice();
    if (saved !== "flip" && saved !== "mist") apply(e.matches);
  });
</script>
