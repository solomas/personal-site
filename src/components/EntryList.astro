---
// The entries of a stream index page as a stack of solid colour bands, one
// per entry, each with a notch and an arrow at its right end (the .notched
// class in global.css). An optional "more" group folds open below them as a
// band of its own, used for Other work on the work page.
interface Item {
  href: string;
  date: string;
  title: string;
  summary: string;
}

interface More {
  label: string;
  caption: string;
  items: Item[];
}

interface Props {
  items: Item[];
  more?: More;
}

const { items, more } = Astro.props;
---
<div class="entry-panel-wrap">
  <div class="entry-panel focus-panel">
    <ul class="entry-list">
      {items.map(item => (
        <li>
          <a href={item.href} class="entry-row glass notched focus-item">
            <span class="entry-row__date meta">{item.date}</span>
            <span class="entry-row__title">{item.title}</span>
            <span class="entry-row__summary meta">{item.summary}</span>
          </a>
        </li>
      ))}
    </ul>

    {more && more.items.length > 0 && (
      <details class="entry-more">
        <summary class="entry-more__summary glass focus-item">
          <span class="entry-more__text">
            <span class="entry-more__label">{more.label}</span>
            <span class="entry-more__caption meta">{more.caption}</span>
          </span>
          <span class="entry-more__marker" aria-hidden="true"></span>
        </summary>
        <ul class="entry-list">
          {more.items.map(item => (
            <li>
              <a href={item.href} class="entry-row glass notched focus-item">
                <span class="entry-row__date meta">{item.date}</span>
                <span class="entry-row__title">{item.title}</span>
                <span class="entry-row__summary meta">{item.summary}</span>
              </a>
            </li>
          ))}
        </ul>
      </details>
    )}
  </div>
</div>

<style>
  .entry-panel-wrap {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-gutter);
  }

  .entry-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .entry-row {
    display: grid;
    grid-template-columns: var(--entry-date-width) 1fr;
    column-gap: var(--space-8);
    row-gap: var(--space-1);
    padding-top: var(--space-6);
    padding-bottom: var(--space-6);
    padding-left: var(--space-6);
    text-decoration: none;
    transition: var(--focus-transition);
  }
  .entry-row__date {
    grid-column: 1;
    grid-row: 1 / span 2;
    padding-top: var(--space-1);
    font-variant-numeric: tabular-nums;
  }
  .entry-row__title {
    grid-column: 2;
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: var(--tracking-title);
    line-height: var(--leading-snug);
  }
  .entry-row__summary {
    grid-column: 2;
    max-width: 60ch;
    font-size: var(--text-base);
  }

  /* Other work: a disclosure band below the list. */
  .entry-more {
    margin-top: var(--space-3);
  }
  .entry-more__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-6);
    list-style: none;
    cursor: pointer;
    transition: var(--focus-transition);
  }
  .entry-more__summary::-webkit-details-marker {
    display: none;
  }
  .entry-more__summary:hover .entry-more__label {
    text-decoration: underline;
    text-decoration-thickness: var(--border-medium);
    text-underline-offset: var(--underline-offset);
  }
  .entry-more__text {
    display: grid;
    gap: var(--space-1);
  }
  .entry-more__label {
    font-size: var(--text-lg);
    font-weight: 600;
  }
  /* A chevron drawn with two borders, turning when the group opens. */
  .entry-more__marker {
    flex-shrink: 0;
    width: 0.6em;
    height: 0.6em;
    border-right: var(--border-medium) solid currentColor;
    border-bottom: var(--border-medium) solid currentColor;
    transform: rotate(45deg);
    transition: transform 220ms var(--ease-out);
  }
  .entry-more[open] .entry-more__marker {
    transform: rotate(-135deg);
  }
  .entry-more[open] > .entry-list {
    margin-top: var(--space-3);
  }

  @media (max-width: 600px) {
    .entry-row {
      grid-template-columns: 1fr;
      padding-top: var(--space-4);
      padding-bottom: var(--space-4);
      padding-left: var(--space-4);
    }
    .entry-row__date {
      grid-row: auto;
      grid-column: 1;
      padding-top: 0;
    }
    .entry-row__title,
    .entry-row__summary {
      grid-column: 1;
    }
    .entry-more__summary {
      padding: var(--space-4);
    }
  }
</style>
