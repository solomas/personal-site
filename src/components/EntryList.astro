---
// Entry list for the stream index pages: one row per entry with date, title
// and summary. The "work" variant adds the title nudge and summary fade the
// work index had on hover.
interface Item {
  href: string;
  date: string;
  title: string;
  summary: string;
}

interface Props {
  items: Item[];
  variant?: "default" | "work";
}

const { items, variant = "default" } = Astro.props;
---
<ul class="entry-list">
  {items.map(item => (
    <li>
      <a href={item.href} class:list={["entry-link", { "entry-link--work": variant === "work" }]}>
        <span class="entry-link__date meta">{item.date}</span>
        <span class="entry-link__title">{item.title}</span>
        <span class="entry-link__summary">{item.summary}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .entry-list {
    list-style: none;
    padding: 0 var(--space-8);
    max-width: var(--page-width);
    margin: 0 auto;
    display: grid;
    gap: 0;
  }
  .entry-link {
    display: grid;
    grid-template-columns: var(--entry-date-width) 1fr;
    column-gap: var(--space-8);
    row-gap: var(--space-2);
    /* Reserve left padding (bar width plus a gap) so the gilt hover bar sits
       clear of the text and toggling it causes no layout shift. */
    padding: var(--space-8) 0 var(--space-8) var(--space-4);
    border-top: var(--border-hairline) solid var(--color-border);
    text-decoration: none;
    /* Load reveal with a light per-item stagger. riseIn lives in global.css. */
    animation: riseIn 340ms var(--ease-out) backwards;
    transition: transform 180ms var(--ease-out), box-shadow 180ms var(--ease-out), color var(--transition);
  }
  /* A lift and a gilt left edge drawn in the reserved left padding, so it
     never overlaps the text. */
  .entry-link:hover {
    transform: translateY(-4px);
    box-shadow: inset var(--border-thick) 0 0 var(--color-accent);
  }
  .entry-link:hover .entry-link__title {
    color: var(--color-accent);
  }
  .entry-list li:nth-child(1) .entry-link { animation-delay: 40ms; }
  .entry-list li:nth-child(2) .entry-link { animation-delay: 80ms; }
  .entry-list li:nth-child(3) .entry-link { animation-delay: 120ms; }
  .entry-list li:nth-child(4) .entry-link { animation-delay: 160ms; }
  .entry-list li:nth-child(5) .entry-link { animation-delay: 200ms; }
  .entry-list li:nth-child(n+6) .entry-link { animation-delay: 240ms; }
  .entry-link__date {
    grid-column: 1;
    grid-row: 1 / span 2;
    align-self: start;
    padding-top: 4px;
  }
  .entry-link__title {
    grid-column: 2;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: var(--tracking-title);
  }
  .entry-link__summary {
    grid-column: 2;
    color: var(--color-muted);
    max-width: 60ch;
  }

  /* Work variant: the title nudges right and the summary comes to full
     strength on hover. */
  .entry-link--work .entry-link__title {
    display: inline-block;
    transition: transform 200ms ease;
  }
  .entry-link--work .entry-link__summary {
    opacity: 0.85;
    transition: opacity 200ms ease;
  }
  .entry-link--work:hover .entry-link__title {
    transform: translateX(4px);
  }
  .entry-link--work:hover .entry-link__summary {
    opacity: 1;
  }

  @media (max-width: 600px) {
    .entry-link { grid-template-columns: 1fr; }
    .entry-link__date { grid-row: 1; }
  }

  /* The global rule stops the motion, this stops the hover lift. */
  @media (prefers-reduced-motion: reduce) {
    .entry-link:hover { transform: none; }
  }
</style>
