---
import "../styles/global.css";
import Shapes from "./Shapes.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  title: string;
  description?: string;
  /* Slower background drift, used on the detail pages. */
  slowShapes?: boolean;
}

const { title, description = "Tomás van Gorp. Projects, work, research.", slowShapes = false } = Astro.props;
const pathname = Astro.url.pathname;
const navItems = [
  { href: "/projects/", label: "Projects" },
  { href: "/work/", label: "Work" },
  { href: "/research/", label: "Research" },
  { href: "/contact/", label: "Contact" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline>
      // Theme before first paint, so there is no flash. A stored "flip" means
      // night and a stored "mist" means mist. With no stored choice the first
      // visit follows the system setting.
      (function () {
        var night = false;
        try {
          var saved = localStorage.getItem("theme");
          if (saved === "flip") {
            night = true;
          } else if (saved !== "mist") {
            night = window.matchMedia("(prefers-color-scheme: dark)").matches;
          }
        } catch (e) {
          night = !!(window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches);
        }
        if (night) {
          document.documentElement.setAttribute("data-theme", "flip");
        }
      })();
    </script>
    <link rel="preload" href="/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <Shapes slow={slowShapes} />
    <header class="site-header">
      <div class="site-nav glass">
        <a href="/" class="site-nav__name"><span class="focus-context">Tomás van Gorp</span></a>
        <nav class="site-nav__links focus-context" aria-label="Primary">
          {navItems.map(item => {
            const active = pathname.startsWith(item.href);
            return (
              <a
                href={item.href}
                class:list={["site-nav__link", { "is-active": active }]}
                aria-current={active ? "page" : undefined}
              >{item.label}</a>
            );
          })}
        </nav>
        <ThemeToggle />
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <span>Last updated {new Date().getFullYear()}.</span>
      <a href="/contact/" class="site-footer__contact">Contact</a>
    </footer>

    <style>
      /* Floating glass navigation. It sits in the page flow at the top, not
         fixed, so it only ever lies over the background and never over
         text. */
      .site-header {
        padding: var(--space-4) var(--page-gutter) 0;
      }
      .site-nav {
        max-width: var(--page-width);
        margin: 0 auto;
        display: flex;
        align-items: center;
        gap: var(--space-6);
        padding: var(--space-2) var(--space-2) var(--space-2) var(--space-6);
        border-radius: var(--radius-pill);
      }
      .site-nav a {
        color: var(--color-ink);
      }
      .site-nav__name {
        font-size: var(--text-base);
        font-weight: 600;
        letter-spacing: var(--tracking-snug);
        text-decoration: none;
        white-space: nowrap;
      }
      .site-nav__links {
        display: flex;
        gap: var(--space-6);
        flex: 1;
        justify-content: flex-end;
      }
      .site-nav__link {
        font-size: var(--text-sm);
        text-decoration: none;
        padding: var(--space-1) 0;
      }
      /* Active link: bold in the highlight colour, with aria-current. Hover
         underlines. */
      .site-nav__link:hover {
        text-decoration: underline;
        text-decoration-thickness: var(--border-hairline);
        text-underline-offset: var(--underline-offset);
      }
      .site-nav a.site-nav__link.is-active {
        font-weight: 700;
        color: var(--color-highlight);
      }

      .site-main {
        min-height: 60vh;
      }

      /* Footer text sits bare on the background, so it uses ink. */
      .site-footer {
        max-width: var(--page-width);
        margin: var(--space-24) auto 0;
        padding: var(--space-8) var(--page-gutter);
        display: flex;
        justify-content: space-between;
        gap: var(--space-4);
        flex-wrap: wrap;
        font-size: var(--text-sm);
      }

      @media (max-width: 720px) {
        .site-nav {
          flex-wrap: wrap;
          row-gap: var(--space-1);
          border-radius: var(--radius-lg);
          padding: var(--space-3) var(--space-3) var(--space-3) var(--space-4);
        }
        .site-nav__name {
          flex: 1;
        }
        .site-nav__links {
          order: 3;
          flex-basis: 100%;
          justify-content: space-between;
          gap: var(--space-3);
        }
      }
    </style>
  </body>
</html>
