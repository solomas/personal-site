---
// The background: two large, soft, round shapes in the theme's shape colour
// (yellow in day, blue in night) that drift slowly behind all content, with a
// fine static grain on top.
//
// Each shape is one radial gradient, solid in its core and fading to
// transparent at the rim. No blur filter. Only transform animates (position,
// a little scale, a little rotation), each shape on its own cycle, so the
// pattern never visibly repeats. With slow, as on the detail pages, every
// cycle runs three times longer.
//
// The two shapes never overlap. Shape A sits top left, shape B bottom centre,
// and their sizes and drift ranges keep the gap open at every viewport shape
// from 390 by 844 to 3840 by 2160 (worked through in the 2026-09-25d session
// doc). Both also stay clear of the right gutter, where the stripe lives.
//
// The animation pauses while the tab is hidden. The global reduced motion
// rule removes it, so the shapes stand still.
//
// The grain is an SVG noise tile rendered once as a background image, not an
// animated filter. It sits over the shapes and under the glass, and breaks up
// banding. Sizes, positions and paths are chosen by eye within those limits.
interface Props {
  slow?: boolean;
}

const { slow = false } = Astro.props;

// Grain tile: fractal noise, desaturated, as a data URI.
const grain = `url("data:image/svg+xml,${encodeURIComponent(
  '<svg xmlns="http://www.w3.org/2000/svg" width="180" height="180"><filter id="n"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" stitchTiles="stitch"/><feColorMatrix type="saturate" values="0"/></filter><rect width="100%" height="100%" filter="url(#n)"/></svg>'
)}")`;
---
<div class:list={["shapes", { "shapes--slow": slow }]} aria-hidden="true">
  <div class="shape shape--a"></div>
  <div class="shape shape--b"></div>
  <div class="shapes__grain" style={`background-image: ${grain}`}></div>
</div>

<style>
  .shapes {
    /* 1 on most pages, 3 on the detail pages. */
    --pace: 1;
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: var(--color-ground);
    pointer-events: none;
  }
  .shapes--slow {
    --pace: 3;
  }

  .shape {
    position: absolute;
    will-change: transform;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    animation-direction: alternate;
  }
  .shapes.is-paused .shape {
    animation-play-state: paused;
  }

  /* Each shape is an ellipse up to 52 by 44 vmin, capped at 560px wide on
     very large screens. The gradient is solid to 45 percent of the radius and
     fades out at the rim. */
  .shape {
    --w: min(52vmin, 560px);
    --h: calc(var(--w) * 44 / 52);
    width: var(--w);
    height: var(--h);
    background: radial-gradient(closest-side, var(--color-shape) 45%, transparent 100%);
  }
  .shape--a {
    left: calc(18vw - var(--w) / 2);
    top: calc(20vh - var(--h) / 2);
    animation-name: drift-a;
    animation-duration: calc(83s * var(--pace));
  }
  .shape--b {
    left: calc(50vw - var(--w) / 2);
    top: calc(78vh - var(--h) / 2);
    animation-name: drift-b;
    animation-duration: calc(109s * var(--pace));
  }

  .shapes__grain {
    position: absolute;
    inset: 0;
    background-size: 180px 180px;
    opacity: var(--grain-opacity);
  }

  /* Drift stays within 3vw sideways, 4vh up or down, 4 percent of scale and
     a few degrees of rotation. The non overlap check depends on these limits. */
  @keyframes drift-a {
    0%   { transform: translate(0, 0) rotate(0deg) scale(1); }
    35%  { transform: translate(3vw, 3vh) rotate(8deg) scale(1.03); }
    70%  { transform: translate(-2vw, 4vh) rotate(-6deg) scale(0.97); }
    100% { transform: translate(2vw, -3vh) rotate(4deg) scale(1.04); }
  }
  @keyframes drift-b {
    0%   { transform: translate(0, 0) rotate(0deg) scale(1); }
    40%  { transform: translate(-3vw, -4vh) rotate(-7deg) scale(1.04); }
    75%  { transform: translate(2vw, -2vh) rotate(6deg) scale(0.96); }
    100% { transform: translate(-1vw, 3vh) rotate(-3deg) scale(1.02); }
  }
</style>

<script>
  // Pause the drift while the tab is hidden.
  const shapes = document.querySelector(".shapes");
  const sync = () => shapes?.classList.toggle("is-paused", document.hidden);
  document.addEventListener("visibilitychange", sync);
  sync();
</script>
