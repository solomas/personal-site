---
// The background: four large, stretched, organic shapes in the theme's shape
// colour (yellow in day, blue in night) that drift slowly behind all content,
// with a fine static grain on top.
//
// Each shape is two or three radial gradients in one colour, solid through
// most of their radius and fading only at the rim, so the colour reads
// clearly with a soft edge. No blur filter. The shapes share one colour, so
// they may overlap. Only transform animates (position, a little scale, a
// little rotation), each shape on its own cycle between 60 and 120 seconds.
// With slow, as on the detail pages, every cycle runs three times longer.
//
// The drift follows a clock shared across pages. The inline script below
// sets a negative animation delay from that clock before first paint, so a
// visitor moving to another page sees the shapes carry on where they were.
// The clock lives in sessionStorage as virtual time: it advances at full
// speed on normal pages and at a third on detail pages, so switching between
// the two never makes the shapes jump. With nothing stored it starts from the
// wall clock.
//
// The animation pauses while the tab is hidden. The global reduced motion
// rule removes it, so the shapes stand still.
//
// The grain is an SVG noise tile rendered once as a background image, not an
// animated filter. It sits over the shapes and under the glass. Sizes,
// positions and paths are chosen by eye.
interface Props {
  slow?: boolean;
}

const { slow = false } = Astro.props;

// Grain tile: fractal noise, desaturated, as a data URI.
const grain = `url("data:image/svg+xml,${encodeURIComponent(
  '<svg xmlns="http://www.w3.org/2000/svg" width="180" height="180"><filter id="n"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" stitchTiles="stitch"/><feColorMatrix type="saturate" values="0"/></filter><rect width="100%" height="100%" filter="url(#n)"/></svg>'
)}")`;
---
<div class:list={["shapes", { "shapes--slow": slow }]} data-pace={slow ? "3" : "1"} aria-hidden="true">
  <div class="shape shape--a"></div>
  <div class="shape shape--b"></div>
  <div class="shape shape--c"></div>
  <div class="shape shape--d"></div>
  <div class="shapes__grain" style={`background-image: ${grain}`}></div>
</div>
<script is:inline>
  (function () {
    var root = document.querySelector(".shapes");
    if (!root) return;
    var KEY = "shapes-clock";
    var pace = Number(root.getAttribute("data-pace")) || 1;
    // Virtual time in milliseconds of normal speed drift.
    var v0 = Date.now();
    try {
      var saved = JSON.parse(sessionStorage.getItem(KEY) || "null");
      if (saved && Date.now() - saved.r < 30 * 60 * 1000) {
        v0 = saved.v + (Date.now() - saved.r) / saved.p;
      }
    } catch (e) {}

    // Each shape runs alternate cycles, so one full loop is two durations.
    root.querySelectorAll(".shape").forEach(function (shape) {
      var d = parseFloat(getComputedStyle(shape).animationDuration) * 1000;
      if (!d) return;
      shape.style.animationDelay = "-" + ((v0 * pace) % (2 * d)) + "ms";
    });

    var start = performance.now();
    var hiddenAt = null;
    var hiddenTotal = 0;
    function sync() {
      if (document.hidden) {
        hiddenAt = performance.now();
        root.classList.add("is-paused");
      } else {
        if (hiddenAt !== null) hiddenTotal += performance.now() - hiddenAt;
        hiddenAt = null;
        root.classList.remove("is-paused");
      }
    }
    document.addEventListener("visibilitychange", sync);
    if (document.hidden) sync();

    window.addEventListener("pagehide", function () {
      var now = performance.now();
      var running = now - start - hiddenTotal - (hiddenAt !== null ? now - hiddenAt : 0);
      try {
        sessionStorage.setItem(KEY, JSON.stringify({ v: v0 + running / pace, r: Date.now(), p: pace }));
      } catch (e) {}
    });
  })();
</script>

<style>
  .shapes {
    /* 1 on most pages, 3 on the detail pages. */
    --pace: 1;
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: var(--color-ground);
    pointer-events: none;
  }
  .shapes--slow {
    --pace: 3;
  }
  /* Size factor. On tall, narrow screens vmax follows the height, so the
     shapes shrink to keep the ground visible between them. Chosen by eye. */
  .shapes {
    --k: 1;
  }
  @media (max-aspect-ratio: 3/4) {
    .shapes {
      --k: 0.7;
    }
  }

  .shape {
    position: absolute;
    will-change: transform;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    animation-direction: alternate;
  }
  /* The base tilt also holds when the animation is off, under reduced
     motion. */
  .shape {
    transform: rotate(var(--r));
  }
  .shapes.is-paused .shape {
    animation-play-state: paused;
  }

  /* Each shape is a long body plus one or two lobes, all in the shape colour,
     solid to about 60 percent of their radius. The base tilt --r is part of
     every keyframe, so the drift turns around it. */
  .shape--a {
    --r: -18deg;
    width: calc(88vmax * var(--k));
    height: calc(32vmax * var(--k));
    left: calc(-30vmax * var(--k));
    top: calc(-12vmax * var(--k));
    background:
      radial-gradient(closest-side at 50% 50%, var(--color-shape) 62%, transparent 100%),
      radial-gradient(closest-side at 78% 62%, var(--color-shape) 55%, transparent 96%);
    animation-name: drift-a;
    animation-duration: calc(83s * var(--pace));
  }
  .shape--b {
    --r: 64deg;
    width: calc(70vmax * var(--k));
    height: calc(24vmax * var(--k));
    right: calc(-30vmax * var(--k));
    top: calc(8vmax * var(--k));
    background:
      radial-gradient(closest-side at 46% 50%, var(--color-shape) 60%, transparent 100%),
      radial-gradient(closest-side at 22% 40%, var(--color-shape) 50%, transparent 94%);
    animation-name: drift-b;
    animation-duration: calc(109s * var(--pace));
  }
  .shape--c {
    --r: 8deg;
    width: calc(80vmax * var(--k));
    height: calc(26vmax * var(--k));
    left: calc(-18vmax * var(--k));
    bottom: calc(-16vmax * var(--k));
    background:
      radial-gradient(closest-side at 50% 50%, var(--color-shape) 60%, transparent 100%),
      radial-gradient(closest-side at 76% 36%, var(--color-shape) 48%, transparent 92%),
      radial-gradient(closest-side at 24% 64%, var(--color-shape) 44%, transparent 90%);
    animation-name: drift-c;
    animation-duration: calc(97s * var(--pace));
  }
  .shape--d {
    --r: -40deg;
    width: calc(40vmax * var(--k));
    height: calc(16vmax * var(--k));
    left: 40%;
    top: 44%;
    background:
      radial-gradient(closest-side at 50% 50%, var(--color-shape) 58%, transparent 100%),
      radial-gradient(closest-side at 70% 30%, var(--color-shape) 46%, transparent 92%);
    animation-name: drift-d;
    animation-duration: calc(71s * var(--pace));
  }

  .shapes__grain {
    position: absolute;
    inset: 0;
    background-size: 180px 180px;
    opacity: var(--grain-opacity);
  }

  @keyframes drift-a {
    0%   { transform: translate(0, 0) rotate(var(--r)) scale(1); }
    35%  { transform: translate(8vw, 5vh) rotate(calc(var(--r) + 7deg)) scale(1.05); }
    70%  { transform: translate(2vw, 12vh) rotate(calc(var(--r) - 4deg)) scale(0.97); }
    100% { transform: translate(10vw, 3vh) rotate(calc(var(--r) + 3deg)) scale(1.03); }
  }
  @keyframes drift-b {
    0%   { transform: translate(0, 0) rotate(var(--r)) scale(1); }
    40%  { transform: translate(-9vw, 10vh) rotate(calc(var(--r) - 6deg)) scale(1.04); }
    75%  { transform: translate(-3vw, 18vh) rotate(calc(var(--r) + 5deg)) scale(0.96); }
    100% { transform: translate(-11vw, 6vh) rotate(calc(var(--r) - 2deg)) scale(1.02); }
  }
  @keyframes drift-c {
    0%   { transform: translate(0, 0) rotate(var(--r)) scale(1); }
    30%  { transform: translate(10vw, -7vh) rotate(calc(var(--r) + 6deg)) scale(1.04); }
    65%  { transform: translate(16vw, -2vh) rotate(calc(var(--r) - 5deg)) scale(0.96); }
    100% { transform: translate(6vw, -11vh) rotate(calc(var(--r) + 2deg)) scale(1.05); }
  }
  @keyframes drift-d {
    0%   { transform: translate(0, 0) rotate(var(--r)) scale(1); }
    30%  { transform: translate(-10vw, 8vh) rotate(calc(var(--r) + 9deg)) scale(1.07); }
    60%  { transform: translate(6vw, 13vh) rotate(calc(var(--r) - 7deg)) scale(0.94); }
    100% { transform: translate(12vw, -5vh) rotate(calc(var(--r) + 4deg)) scale(1.04); }
  }
</style>
