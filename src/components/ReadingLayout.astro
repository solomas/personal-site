---
// The reading frame shared by the detail pages and the about page: a column
// in the centred page, holding a colour band as header strip and a solid reading
// sheet, 68 characters wide and left aligned. Detail pages drift the shapes
// three times slower.
//   slot "before"  above the strip (the back link on detail pages)
//   slot "strip"   inside the header strip
//   default slot   inside the reading sheet
import Layout from "./Layout.astro";

interface Props {
  title: string;
  /* Page summary for the description and social preview tags. */
  description?: string;
  /* Language of the page and its versions in other languages, passed on
     to Layout. */
  lang?: string;
  alternates?: { lang: string; href: string }[];
}

const { title, description, lang, alternates } = Astro.props;
---
<Layout title={title} description={description} lang={lang} alternates={alternates} slowShapes>
  <div class="reading">
    <slot name="before" />
    <div class="reading__column">
      <div class="reading__strip glass" data-vt-header>
        <slot name="strip" />
      </div>
      <article class="reading__sheet sheet">
        <slot />
      </article>
    </div>
  </div>
</Layout>

<style>
  /* The page column is centred, the strip and sheet sit left aligned in it.
     --reading-pad is read by the pages that fill the frame. */
  .reading {
    --reading-pad: var(--space-12);
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-12) var(--page-gutter) 0;
  }
  /* The column sets the width in characters of the base size, so smaller
     type inside the strip does not shrink it. */
  .reading__column {
    max-width: calc(var(--content-width) + 2 * var(--reading-pad));
  }
  .reading__strip {
    padding: var(--space-3) var(--reading-pad);
    margin-bottom: var(--space-4);
    color: var(--color-muted);
  }
  .reading__sheet {
    padding: var(--reading-pad);
  }
  @media (max-width: 720px) {
    .reading {
      --reading-pad: var(--space-6);
      padding-top: var(--space-8);
    }
  }
</style>
