---
// Title and short intro of the stream index pages, in the left column of
// StreamLayout. Both sit bare on the background, so both are ink.
interface Props {
  title: string;
  lede?: string;
}

const { title, lede } = Astro.props;
---
<header class="stream-header focus-context" data-vt-header>
  <h1>{title}</h1>
  {lede && <p class="stream-header__lede">{lede}</p>}
</header>

<style>
  .stream-header h1 {
    font-size: clamp(var(--text-3xl), 5vw, var(--text-4xl));
    font-weight: 700;
    letter-spacing: var(--tracking-display);
    line-height: 1;
    margin-bottom: var(--space-4);
  }
  .stream-header__lede {
    max-width: 50ch;
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }
  @media (max-width: 960px) {
    .stream-header h1 {
      font-size: var(--text-title);
    }
  }
</style>
