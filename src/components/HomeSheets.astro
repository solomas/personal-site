---
// The three streams on the home page as solid colour bands, stacked beside
// the hero. Each band carries a small number, the title and one line, and a
// half circle bitten out of its right end, holding the arrow (the .notched
// class in global.css).
// Hover and keyboard focus move the arrow a little.
//
// Motion: on the first visit the bands settle into place, once, gated by the
// "triptych-revealed" localStorage key. The focus on hover effect comes from
// global.css, in its strong version (data-focus="strong").
const sheets = [
  { href: "/research/", title: "Research", line: "My PhD on how governments turn planetary health plans into practice." },
  { href: "/work/", title: "Work", line: "Consulting, board support and programme design." },
  { href: "/projects/", title: "Projects", line: "Tools and experiments of my own." },
];
---
<nav class="stack focus-panel" data-focus="strong" aria-label="Three streams of work">
  {sheets.map((sheet, i) => (
    <a href={sheet.href} class="home-band glass notched focus-item" style={`--i: ${i}`}>
      <span class="home-band__number" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
      <span class="home-band__text">
        <span class="home-band__title">{sheet.title}</span>
        <span class="home-band__line">{sheet.line}</span>
      </span>
    </a>
  ))}
</nav>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .home-band {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    align-items: center;
    min-height: 6rem;
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
    padding-left: var(--space-6);
    text-decoration: none;
    transition: var(--focus-transition);
  }
  .home-band__number {
    font-size: var(--text-sm);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }
  .home-band__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .home-band__title {
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: var(--tracking-title);
    line-height: var(--leading-tight);
  }
  .home-band__line {
    font-size: var(--text-base);
    line-height: var(--leading-snug);
    color: var(--color-muted);
  }

  /* First visit only: the bands slide in from the right, one after the
     other. The markup ships in the rest position, so no JS, return visits
     and reduced motion all show the bands at rest. */
  .stack[data-reveal] .home-band {
    animation: band-settle 700ms var(--ease-out) backwards;
    animation-delay: calc(var(--i) * 110ms);
  }
  @keyframes band-settle {
    from {
      opacity: 0;
      transform: translateX(var(--space-8));
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 720px) {
    .home-band {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      padding-left: var(--space-4);
    }
    .home-band__title {
      font-size: var(--text-lg);
    }
  }
</style>

<script is:inline>
  (function () {
    var stack = document.querySelector(".stack");
    if (!stack) return;
    var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var revealed = false;
    try { revealed = localStorage.getItem("triptych-revealed") === "1"; } catch (e) {}
    if (reduceMotion || revealed) return;
    stack.setAttribute("data-reveal", "");
    // The last band lands at about 920ms. Set the key after that.
    window.setTimeout(function () {
      try { localStorage.setItem("triptych-revealed", "1"); } catch (e) {}
    }, 1200);
  })();
</script>
