---
// The PhD on one line, from the start in October 2025 to the expected
// completion in July 2029, with each part of the research as a point on the
// date of its last milestone and a point for today.
//
// Each part is one link: its name, a thin stem and its dot on the line, so
// the dot and the name both open the part. The parts sit close together in
// time, so their names stand in rows above the line, the earliest highest,
// and each stem runs down to its own dot without crossing another name. On
// narrow screens the line turns vertical: the markers on the left, the
// names on the right, each joined to its dot by a thin elbow.
//
// Today is placed at build time and moved to the visitor's date by the
// script below, so without JavaScript the point shows the build date.
// Nothing animates. A dot grows a little on hover and focus, which reduced
// motion turns into a direct change.
import { getCollection } from "astro:content";

const START = new Date("2025-10-01T00:00:00Z");
const END = new Date("2029-07-31T00:00:00Z");
const span = END.valueOf() - START.valueOf();
const frac = (d: Date) => Math.min(1, Math.max(0, (d.valueOf() - START.valueOf()) / span));

const parts = (await getCollection("research", ({ data }) => data.status !== "archived" && !data.featured))
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

// Vertical layout, in rem: the line length and the room one name needs.
// The names are placed at build time, each at its dot or just below the
// name before it. Chosen by eye.
const LEN = 30;
const ROW_V = 2;
let prev = -Infinity;
const points = parts.map((entry, i) => {
  const f = frac(entry.data.date);
  const dotY = f * LEN;
  const labelY = Math.max(dotY, prev + ROW_V);
  prev = labelY;
  return {
    href: `/research/${entry.id}/`,
    name: entry.data.title.split(":")[0],
    month: entry.data.date.toLocaleDateString("en-GB", { month: "long", year: "numeric", timeZone: "UTC" }),
    frac: f,
    slot: parts.length - i,
    dotY,
    labelY,
  };
});
const trackV = Math.max(LEN, prev + ROW_V) + 1;
const built = new Date();
const builtLabel = built.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
---
<section class="timeline-wrap" aria-labelledby="timeline-title">
  <div class="timeline glass-panel">
    <h2 id="timeline-title" class="timeline__title">PhD, October 2025 to July 2029</h2>
    <div class="timeline__track" style={`--rows: ${points.length}; --track-v: ${trackV}rem; --len: ${LEN}rem`}>
      <div class="timeline__line" aria-hidden="true"></div>
      <ol class="timeline__points">
        {points.map(point => (
          <li class="timeline__point" style={`--frac: ${point.frac}; --slot: ${point.slot}; --dot-y: ${point.dotY}rem; --label-y: ${point.labelY}rem`}>
            <a href={point.href} class="timeline__link">
              <span class="timeline__stem" aria-hidden="true"></span>
              <span class="timeline__dot" aria-hidden="true"></span>
              <span class="timeline__name">{point.name}</span><span class="visually-hidden">, {point.month}</span>
            </a>
          </li>
        ))}
      </ol>
      <p class="timeline__marker timeline__marker--start" style="--frac: 0">Start</p>
      <p class="timeline__marker timeline__marker--today" style={`--frac: ${frac(built)}`} data-timeline-today data-start={START.valueOf()} data-end={END.valueOf()}>
        <span class="timeline__now" aria-hidden="true"></span>Today<span class="visually-hidden">, <span data-timeline-date>{builtLabel}</span></span>
      </p>
      <p class="timeline__marker timeline__marker--end" style="--frac: 1">Expected completion</p>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var el = document.querySelector("[data-timeline-today]");
    if (!el) return;
    var start = Number(el.getAttribute("data-start"));
    var end = Number(el.getAttribute("data-end"));
    var now = Date.now();
    var f = Math.min(1, Math.max(0, (now - start) / (end - start)));
    el.style.setProperty("--frac", String(f));
    var label = el.querySelector("[data-timeline-date]");
    if (label) {
      label.textContent = new Date(now).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
    }
  })();
</script>

<style>
  .timeline-wrap {
    max-width: var(--page-width);
    margin: 0 auto var(--space-6);
    padding: 0 var(--page-gutter);
  }
  .timeline {
    /* The room one row of names takes above the line, and where the line
       sits below the rows. Chosen by eye. */
    --row: 1.75rem;
    --dot: 10px;
    --now: 14px;
    padding: var(--space-8) var(--space-12) var(--space-8);
  }
  .timeline__title {
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: var(--tracking-snug);
    margin-bottom: var(--space-6);
  }
  /* --rows comes from the markup on the track, so the line position is
     worked out here. */
  .timeline__track {
    --line-y: calc(var(--rows) * var(--row) + 0.75rem);
    position: relative;
    height: calc(var(--line-y) + 2.5rem);
  }
  .timeline__points {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* Horizontal: one straight line, the names in rows above it. */
  .timeline__line {
    position: absolute;
    left: 0;
    right: 0;
    top: var(--line-y);
    height: var(--border-medium);
    background: var(--color-muted);
  }
  /* The parts paint above the today marker, so a part dated close to
     today stays visible on top of the now dot. */
  .timeline__point {
    position: absolute;
    z-index: 1;
    top: 0;
    left: calc(var(--frac) * 100%);
  }
  .timeline__link {
    position: absolute;
    left: 0;
    top: calc((var(--rows) - var(--slot)) * var(--row));
    padding-left: var(--space-3);
    font-size: var(--text-sm);
    line-height: 1.2rem;
    white-space: nowrap;
  }
  .timeline__stem {
    position: absolute;
    left: 0;
    top: 0.6rem;
    width: var(--border-hairline);
    height: calc(var(--line-y) - (var(--rows) - var(--slot)) * var(--row) - 0.6rem);
    background: var(--color-muted);
  }
  .timeline__dot {
    position: absolute;
    left: calc(var(--dot) / -2);
    top: calc(var(--line-y) - (var(--rows) - var(--slot)) * var(--row) - var(--dot) / 2 + var(--border-hairline));
    width: var(--dot);
    height: var(--dot);
    border-radius: 50%;
    background: var(--color-ink);
    transition: transform var(--transition);
  }
  .timeline__link:hover .timeline__dot,
  .timeline__link:focus-visible .timeline__dot {
    transform: scale(1.5);
  }

  /* Start, today and the expected completion sit under the line. */
  .timeline__marker {
    position: absolute;
    top: calc(var(--line-y) + 0.9rem);
    left: calc(var(--frac) * 100%);
    transform: translateX(-50%);
    font-size: var(--text-sm);
    line-height: 1.2rem;
    white-space: nowrap;
    color: var(--color-muted);
  }
  .timeline__marker--start {
    transform: none;
  }
  .timeline__marker--end {
    transform: translateX(-100%);
  }
  .timeline__marker--start::before,
  .timeline__marker--end::before {
    content: "";
    position: absolute;
    top: calc(-0.9rem - 0.4rem);
    width: var(--border-medium);
    height: 0.8rem;
    background: var(--color-muted);
  }
  .timeline__marker--start::before {
    left: 0;
  }
  .timeline__marker--end::before {
    right: 0;
  }
  .timeline__marker--today {
    color: var(--color-ink);
    font-weight: 600;
  }
  /* The now dot: yellow in both themes, with an ink ring so it reads on the
     white glass of day. */
  .timeline__now {
    position: absolute;
    left: calc(50% - var(--now) / 2);
    top: calc(-0.9rem - var(--now) / 2 + var(--border-hairline));
    width: var(--now);
    height: var(--now);
    border-radius: 50%;
    background: var(--yellow);
    box-shadow: 0 0 0 var(--border-medium) var(--color-ink);
  }
  :global([data-theme="flip"]) .timeline__now {
    box-shadow: none;
  }

  /* Narrow: the line turns vertical. Markers on the left, names on the
     right, each name joined to its dot by a thin elbow. */
  @media (max-width: 720px) {
    .timeline {
      --line-x: 7rem;
      --gap: 1.5rem;
      padding: var(--space-6);
    }
    .timeline__track {
      height: var(--track-v);
      margin-top: var(--space-4);
    }
    .timeline__line {
      left: var(--line-x);
      right: auto;
      top: 0;
      width: var(--border-medium);
      height: var(--len);
    }
    .timeline__point {
      left: 0;
    }
    .timeline__link {
      left: calc(var(--line-x) + var(--gap));
      top: calc(var(--label-y) - 0.6rem);
      padding-left: 0;
      white-space: normal;
      width: max-content;
      max-width: 11rem;
    }
    .timeline__stem {
      left: calc(-1 * var(--gap));
      top: calc(var(--dot-y) - var(--label-y) + 0.6rem);
      width: calc(var(--gap) - 0.35rem);
      height: calc(var(--label-y) - var(--dot-y));
      background: none;
      border-top: var(--border-hairline) solid var(--color-muted);
      border-right: var(--border-hairline) solid var(--color-muted);
    }
    .timeline__stem::after {
      content: "";
      position: absolute;
      right: -0.35rem;
      bottom: 0;
      width: 0.3rem;
      height: var(--border-hairline);
      background: var(--color-muted);
    }
    .timeline__dot {
      left: calc(-1 * var(--gap) - var(--dot) / 2 + var(--border-hairline));
      top: calc(var(--dot-y) - var(--label-y) + 0.6rem - var(--dot) / 2);
    }
    .timeline__marker {
      left: 0;
      top: calc(var(--frac) * var(--len) - 0.6rem);
      width: calc(var(--line-x) - var(--space-4));
      transform: none;
      text-align: right;
      white-space: normal;
      line-height: 1.2rem;
    }
    .timeline__marker--end {
      transform: none;
    }
    .timeline__marker--start::before,
    .timeline__marker--end::before {
      top: 0.6rem;
      left: auto;
      right: calc(-1 * var(--space-4) - 0.4rem + var(--border-hairline));
      width: 0.8rem;
      height: var(--border-medium);
    }
    .timeline__marker--end {
      top: calc(var(--len) - 0.6rem);
    }
    .timeline__now {
      left: calc(100% + var(--space-4) - var(--now) / 2 + var(--border-hairline));
      top: calc(0.6rem - var(--now) / 2);
    }
  }
</style>
