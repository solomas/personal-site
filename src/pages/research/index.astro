---
import Layout from "../../components/Layout.astro";
import StreamHeader from "../../components/StreamHeader.astro";
import EntryList from "../../components/EntryList.astro";
import DeckPanel from "../../components/DeckPanel.astro";
import ThesisPanel from "../../components/ThesisPanel.astro";
import { getCollection } from "astro:content";
// The featured entry, the thesis overview, is the header panel above the
// deck panel. The dated list holds its parts, newest first.
const entries = await getCollection("research", ({ data }) => data.status !== "archived" && !data.featured);
entries.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const items = entries.map(entry => ({
  href: `/research/${entry.id}/`,
  date: entry.data.date.toLocaleDateString("en-GB", { year: "numeric", month: "short" }),
  title: entry.data.title,
  summary: entry.data.summary,
}));
const lede = "My PhD and the pieces it is built from: the proposal, a literature review, a conceptual paper and the tool I code the cases in.";
---
<Layout title="Research" description={lede}>
  <StreamHeader
    title="Research"
    lede={lede}
  />
  <ThesisPanel />
  <DeckPanel />
  <EntryList items={items} />
</Layout>
