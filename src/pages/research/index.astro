---
import Layout from "../../components/Layout.astro";
import StreamHeader from "../../components/StreamHeader.astro";
import EntryList from "../../components/EntryList.astro";
import DeckPanel from "../../components/DeckPanel.astro";
import { getCollection } from "astro:content";
const entries = await getCollection("research", ({ data }) => data.status !== "archived");
// Featured first (the project overview sits above its own parts), then date descending.
entries.sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return b.data.date.valueOf() - a.data.date.valueOf();
});
const items = entries.map(entry => ({
  href: `/research/${entry.id}/`,
  date: entry.data.date.toLocaleDateString("en-GB", { year: "numeric", month: "short" }),
  title: entry.data.title,
  summary: entry.data.summary,
}));
const lede = "Doctoral work, papers, talks and notes from the field.";
---
<Layout title="Research" description={lede}>
  <StreamHeader
    title="Research"
    lede={lede}
  />
  <DeckPanel />
  <EntryList items={items} />
</Layout>
