---
import EntryLayout from "../../components/EntryLayout.astro";
import PatternSwitch from "../../components/PatternSwitch.astro";
import CaseProgress from "../../components/CaseProgress.astro";
import { getCollection, render } from "astro:content";
export async function getStaticPaths() {
  const entries = await getCollection("research");
  return entries.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
// An entry places a component with a marker line of its own in the
// markdown, such as <!-- embed:pattern-switch -->. The rendered body is
// split at each marker and the component goes in between, so it sits
// exactly where the text puts it and renders without JavaScript. Unknown
// names render nothing.
const embeds: Record<string, any> = { "pattern-switch": PatternSwitch, "case-progress": CaseProgress };
const html = entry.rendered?.html;
const segments = html ? html.split(/<!--\s*embed:([a-z-]+)\s*-->/) : null;
// An entry with a dateLabel shows that text in the strip instead of its date,
// as the thesis overview does.
const dateLabel = entry.data.dateLabel ?? entry.data.date.toLocaleDateString("en-GB", { year: "numeric", month: "short" });
---
<EntryLayout
  stream="research"
  title={entry.data.title}
  summary={entry.data.summary}
  meta={[dateLabel, entry.data.venue]}
  tags={entry.data.tags}
  coauthors={entry.data.coauthors}
  citation={entry.data.citation}
  links={entry.data.links}
>
  {segments
    ? segments.map((segment, i) => {
        if (i % 2 === 0) return <Fragment set:html={segment} />;
        const Embed = embeds[segment];
        return Embed ? <Embed /> : null;
      })
    : <Content />}
</EntryLayout>
