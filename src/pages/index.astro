---
import Layout from "../components/Layout.astro";
import HomeSheets from "../components/HomeSheets.astro";
---
<Layout title="Tomás van Gorp">
  <section class="home">
    <div>
      <h1 class="home__hero focus-context">I research what happens after a plan is signed, and help organisations make it work.</h1>
      <p class="home__proof focus-context">I'm doing a PhD at the University of Lisbon and support the executive board of a Dutch mental health centre. Earlier I designed and ran programmes for organisations such as ARTIS and InScience.</p>
    </div>
    <HomeSheets />
  </section>
</Layout>

<style>
  .home {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-16) var(--page-gutter) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }
  /* The hero sits bare on the background, so it is ink, in the heaviest
     weight. */
  .home__hero {
    max-width: 22ch;
    font-size: var(--text-hero);
    font-weight: 900;
    letter-spacing: var(--tracking-title);
    line-height: 1.12;
  }
  /* The line under the hero, set as the intro on the stream pages. */
  .home__proof {
    max-width: 50ch;
    margin-top: var(--space-4);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
  }

  @media (max-width: 720px) {
    .home {
      padding-top: var(--space-12);
      gap: var(--space-8);
    }
    .home__proof {
      font-size: var(--text-lg);
    }
  }
</style>
