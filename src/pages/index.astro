---
import Layout from "../components/Layout.astro";
import HomeSheets from "../components/HomeSheets.astro";

// Structured data for search engines: the site and the person it belongs to.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "Tomás van Gorp",
      url: "https://tomasvangorp.com/",
    },
    {
      "@type": "Person",
      name: "Tomás van Gorp",
      alternateName: ["Tomas van Gorp"],
      url: "https://tomasvangorp.com/",
      jobTitle: "PhD researcher in Planetary Health",
      affiliation: { "@type": "CollegeOrUniversity", name: "Universidade de Lisboa" },
      alumniOf: [
        { "@type": "CollegeOrUniversity", name: "HKU University of the Arts Utrecht" },
        { "@type": "CollegeOrUniversity", name: "Erasmus University Rotterdam" },
      ],
      sameAs: [
        "https://www.linkedin.com/in/tomasvangorp",
        "https://orcid.org/0009-0007-1067-039X",
        "https://scholar.google.com/citations?user=CBPBnw0AAAAJ",
      ],
    },
  ],
};
---
<Layout title="Tomás van Gorp | Planetary health researcher, Lisbon" jsonLd={jsonLd}>
  <section class="home">
    <h1 class="home__hero focus-context">I research what happens after a plan is signed, and help organisations make it work.</h1>
    <HomeSheets />
  </section>
</Layout>

<style>
  .home {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-16) var(--page-gutter) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }
  /* The hero sits bare on the background, so it is ink, in the heaviest
     weight. */
  .home__hero {
    max-width: 22ch;
    font-size: var(--text-hero);
    font-weight: 900;
    letter-spacing: var(--tracking-title);
    line-height: 1.12;
  }

  @media (max-width: 720px) {
    .home {
      padding-top: var(--space-12);
      gap: var(--space-8);
    }
  }
</style>
