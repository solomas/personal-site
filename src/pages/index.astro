---
import Layout from "../components/Layout.astro";
import HomeSheets from "../components/HomeSheets.astro";
---
<Layout title="Tomás van Gorp">
  <section class="home">
    <h1 class="home__hero">I work, advise and research where <span class="accent">science</span>, <span class="accent">society</span> and <span class="accent">environment</span> meet.</h1>
    <HomeSheets />
  </section>
</Layout>

<style>
  .home {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-16) var(--page-gutter) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }
  /* The hero sits bare on the background, so it is ink. The three emphasised
     words are bold. */
  .home__hero {
    max-width: 22ch;
    font-size: var(--text-hero);
    font-weight: 500;
    letter-spacing: var(--tracking-title);
    line-height: 1.12;
  }
  .home__hero .accent {
    font-weight: 700;
  }

  @media (max-width: 720px) {
    .home {
      padding-top: var(--space-12);
      gap: var(--space-8);
    }
  }
</style>
