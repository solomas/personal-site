---
import Layout from "../components/Layout.astro";
import HomeSheets from "../components/HomeSheets.astro";
---
<Layout title="Tomás van Gorp">
  <section class="home">
    <h1 class="home__hero focus-context">I research what happens after a plan is signed, and help organisations make it work.</h1>
    <HomeSheets />
  </section>
</Layout>

<style>
  .home {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-16) var(--page-gutter) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }
  /* The hero sits bare on the background, so it is ink, in the heaviest
     weight. */
  .home__hero {
    max-width: 22ch;
    font-size: var(--text-hero);
    font-weight: 900;
    letter-spacing: var(--tracking-title);
    line-height: 1.12;
  }

  @media (max-width: 720px) {
    .home {
      padding-top: var(--space-12);
      gap: var(--space-8);
    }
  }
</style>
