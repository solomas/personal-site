---
import Layout from "../components/Layout.astro";
import HomeSheets from "../components/HomeSheets.astro";

// Structured data for search engines: the site and the person it belongs to.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "Tomás van Gorp",
      url: "https://tomasvangorp.com/",
    },
    {
      "@type": "Person",
      name: "Tomás van Gorp",
      alternateName: ["Tomas van Gorp"],
      url: "https://tomasvangorp.com/",
      jobTitle: "PhD researcher in Planetary Health",
      affiliation: { "@type": "CollegeOrUniversity", name: "Universidade de Lisboa" },
      alumniOf: [
        { "@type": "CollegeOrUniversity", name: "HKU University of the Arts Utrecht" },
        { "@type": "CollegeOrUniversity", name: "Erasmus University Rotterdam" },
      ],
      sameAs: [
        "https://www.linkedin.com/in/tomasvangorp",
        "https://orcid.org/0009-0007-1067-039X",
        "https://scholar.google.com/citations?user=CBPBnw0AAAAJ",
      ],
    },
  ],
};
---
<Layout title="Tomás van Gorp | Planetary health researcher, Lisbon" jsonLd={jsonLd}>
  <section class="home">
    <div class="home__intro focus-context">
      <p class="home__kicker">Planetary health researcher, Lisbon</p>
      <h1 class="home__hero">I research what happens after a plan is signed, and help organisations make it work.</h1>
    </div>
    <div class="home__bands">
      <HomeSheets />
    </div>
  </section>
</Layout>

<style>
  /* The hero on the left, the three bands on the right. Below 900px the
     bands move under the hero. */
  .home {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-16) var(--page-gutter) 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-16);
    row-gap: var(--space-8);
    align-items: start;
  }
  .home__intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  /* Kicker and hero sit bare on the background, so both are ink. */
  .home__kicker {
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .home__hero {
    font-size: clamp(var(--text-2xl), 3.6vw, var(--text-3xl));
    font-weight: 900;
    letter-spacing: var(--tracking-title);
    line-height: 1.12;
  }
  /* The bands start a little lower than the hero. Chosen by eye. */
  .home__bands {
    padding-top: var(--space-12);
  }

  @media (max-width: 900px) {
    .home {
      grid-template-columns: minmax(0, 1fr);
    }
    .home__hero {
      max-width: 22ch;
      font-size: var(--text-hero);
    }
    .home__bands {
      padding-top: 0;
    }
  }
  @media (max-width: 720px) {
    .home {
      padding-top: var(--space-12);
    }
  }
</style>
