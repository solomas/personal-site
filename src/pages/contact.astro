---
import Layout from "../components/Layout.astro";
---
<Layout title="Contact">
  <div class="contact">
    <section class="contact__panel glass-panel">
      <h1>Contact</h1>
      <p class="contact__lede">Write to me at <a href="mailto:hello@tomasvangorp.com">hello@tomasvangorp.com</a>.</p>
      <ul class="contact__list">
        <li><a class="glass-button" href="mailto:hello@tomasvangorp.com">Email</a></li>
        <li><a class="glass-button" href="https://www.linkedin.com/in/tomasvangorp" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        <li><a class="glass-button" href="https://orcid.org/0009-0007-1067-039X" target="_blank" rel="noopener noreferrer">ORCID</a></li>
      </ul>
    </section>
  </div>
</Layout>

<style>
  .contact {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-16) var(--page-gutter) 0;
  }
  .contact__panel {
    max-width: calc(var(--content-width) + 2 * var(--space-12));
    padding: var(--space-12);
  }
  .contact__panel h1 {
    font-size: var(--text-title);
    font-weight: 700;
    letter-spacing: var(--tracking-display);
    line-height: 1;
    margin-bottom: var(--space-4);
  }
  .contact__lede {
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    overflow-wrap: break-word;
  }
  .contact__list {
    list-style: none;
    padding: 0;
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: var(--border-hairline) solid var(--color-hairline);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .contact__list a:hover {
    transform: translateY(-2px);
  }
  @media (prefers-reduced-motion: reduce) {
    .contact__list a:hover { transform: none; }
  }
  @media (max-width: 720px) {
    .contact {
      padding-top: var(--space-12);
    }
    .contact__panel {
      padding: var(--space-6);
    }
    .contact__lede {
      font-size: var(--text-lg);
    }
  }
</style>
