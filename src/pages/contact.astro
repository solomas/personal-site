---
import Layout from "../components/Layout.astro";
import StreamHeader from "../components/StreamHeader.astro";
---
<Layout title="Contact">
  <StreamHeader title="Contact" label="Contact" number="01" kicker="Get in touch">
    <Fragment slot="lede">Get in touch via <a href="mailto:hello@tomasvangorp.com">hello@tomasvangorp.com</a>.</Fragment>
    <ul class="contact-list">
      <li><a href="mailto:hello@tomasvangorp.com" class="contact-link">Email</a></li>
      <li><a href="https://www.linkedin.com/in/tomasvangorp" class="contact-link" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
      <li><a href="https://orcid.org/0009-0007-1067-039X" class="contact-link" target="_blank" rel="noopener noreferrer">ORCID</a></li>
    </ul>
  </StreamHeader>
</Layout>

<style>
  .contact-list {
    list-style: none;
    padding: 0;
    margin-top: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .contact-link {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-snug);
    color: var(--color-muted);
    text-decoration: none;
    display: inline-block;
    /* Load reveal with a light per-item stagger, backwards fill so the hover
       transform is never blocked by a finished animation. riseIn lives in
       global.css. */
    animation: riseIn 340ms var(--ease-out) backwards;
    transition: transform 180ms var(--ease-out), color var(--transition);
  }
  /* A small lift and an underline. */
  .contact-link:hover {
    color: var(--color-accent);
    transform: translateY(-2px);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
    text-decoration-thickness: var(--border-hairline);
  }
  .contact-list li:nth-child(1) .contact-link { animation-delay: 60ms; }
  .contact-list li:nth-child(2) .contact-link { animation-delay: 120ms; }
  .contact-list li:nth-child(3) .contact-link { animation-delay: 180ms; }
  /* The global rule stops the motion, this stops the hover lift. */
  @media (prefers-reduced-motion: reduce) {
    .contact-link:hover { transform: none; }
  }
</style>
