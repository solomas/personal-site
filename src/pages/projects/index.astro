---
import Layout from "../../components/Layout.astro";
import StreamHeader from "../../components/StreamHeader.astro";
import EntryList from "../../components/EntryList.astro";
import { getCollection } from "astro:content";
const entries = await getCollection("projects", ({ data }) => data.status !== "archived");
entries.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const items = entries.map(entry => ({
  href: `/projects/${entry.id}/`,
  date: entry.data.date.toLocaleDateString("en-GB", { year: "numeric", month: "short" }),
  title: entry.data.title,
  summary: entry.data.summary,
}));
---
<Layout title="Projects">
  <StreamHeader
    title="Projects"
    lede="Side work, experiments and things made out of curiosity."
  />
  <EntryList items={items} />
</Layout>
