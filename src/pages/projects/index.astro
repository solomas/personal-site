---
import Layout from "../../components/Layout.astro";
import StreamLayout from "../../components/StreamLayout.astro";
import EntryList from "../../components/EntryList.astro";
import { getCollection } from "astro:content";
const entries = await getCollection("projects", ({ data }) => data.status !== "archived");
entries.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const items = entries.map(entry => ({
  href: `/projects/${entry.id}/`,
  date: entry.data.date.toLocaleDateString("en-GB", { year: "numeric", month: "short" }),
  title: entry.data.title,
  summary: entry.data.summary,
}));
const lede = "Tools and experiments I build in my own time, out of curiosity.";
---
<Layout title="Projects" description={lede}>
  <StreamLayout title="Projects" lede={lede}>
    <EntryList items={items} />
  </StreamLayout>
</Layout>
