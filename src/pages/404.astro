---
// Served by Cloudflare Pages for any unknown path, as dist/404.html.
import Layout from "../components/Layout.astro";
---
<Layout title="Page not found" singleShape noindex>
  <section class="not-found">
    <h1>Page not found</h1>
    <p><a href="/">Go to the home page</a></p>
  </section>
</Layout>

<style>
  /* Heading and link sit bare on the background, so ink and the highlight. */
  .not-found {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-24) var(--page-gutter) 0;
  }
  .not-found h1 {
    font-size: var(--text-title);
    font-weight: 700;
    letter-spacing: var(--tracking-display);
    line-height: 1;
    margin-bottom: var(--space-6);
  }
  .not-found p {
    font-size: var(--text-xl);
  }
  @media (max-width: 720px) {
    .not-found {
      padding-top: var(--space-16);
    }
  }
</style>
