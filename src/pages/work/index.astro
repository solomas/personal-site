---
import Layout from "../../components/Layout.astro";
import StreamHeader from "../../components/StreamHeader.astro";
import EntryList from "../../components/EntryList.astro";
import { getCollection } from "astro:content";
import { formatDateRange } from "../../utils/formatDateRange";

const all = await getCollection("work");
const byDateDesc = (a: (typeof all)[number], b: (typeof all)[number]) => b.data.date.valueOf() - a.data.date.valueOf();
const toItem = (entry: (typeof all)[number]) => ({
  href: `/work/${entry.id}/`,
  date: formatDateRange(entry.data.date, entry.data.endDate, entry.data.current),
  title: entry.data.title,
  summary: entry.data.summary,
});
const live = all.filter(e => e.data.status === "live").sort(byDateDesc).map(toItem);
const archived = all.filter(e => e.data.status === "archived").sort(byDateDesc).map(toItem);
// The meta description keeps the earlier intro. The intro on the page names
// the current work.
const description = "Selected roles and assignments, from a zoo's planetary health programme to board work in mental health care.";
const lede = "I'm doing a PhD at the University of Lisbon and support the executive board of a Dutch mental health centre. Earlier I designed and ran programmes for organisations such as ARTIS and InScience.";
---
<Layout title="Work" description={description}>
  <StreamHeader
    title="Work"
    lede={lede}
  />
  <EntryList
    items={live}
    more={{ label: "Other work", caption: "Earlier roles, for the record.", items: archived }}
  />
</Layout>
